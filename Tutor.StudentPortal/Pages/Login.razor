@page "/login"
@layout StudentPortal.Shared.LoginLayout
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudPaper Elevation="4" Class="pa-8" Style="width:360px; text-align:center;">
    <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size:3rem; color:#1976D2;" Class="mb-2" />
    <MudText Typo="Typo.h5" Style="font-weight:600; color:#3A3A3A;" Class="mb-1">Tutor</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">Student Portal</MudText>

    @if (!_showOtpInput)
    {
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" RequiredError="Email is required" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SendOtpAsync" Disabled="_loading">
                @(_loading ? "Sending OTP..." : "Send OTP")
            </MudButton>
        </MudForm>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-3">OTP sent to @_email</MudText>
        <MudForm @ref="_otpForm" @bind-IsValid="_otpFormIsValid">
            <MudTextField @bind-Value="_otp" Label="Enter OTP" Required="true" RequiredError="OTP is required" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="VerifyOtpAsync" Disabled="_loading" Class="mb-2">
                @(_loading ? "Verifying..." : "Verify OTP")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" OnClick="BackToEmailAsync">
                Back
            </MudButton>
        </MudForm>
    }
</MudPaper>

@code {
    private MudForm? _form;
    private MudForm? _otpForm;
    private string _email = string.Empty;
    private string _otp = string.Empty;
    private bool _showOtpInput = false;
    private bool _loading = false;
    private bool _formIsValid = false;
    private bool _otpFormIsValid = false;

    private async Task SendOtpAsync()
    {
        if (!_formIsValid) return;

        _loading = true;
        try
        {
            var request = new { email = _email };
            var response = await Http.PostAsJsonAsync("api/auth/request-otp", request);
            if (response.IsSuccessStatusCode)
            {
                _showOtpInput = true;
                Snackbar.Add("OTP sent to your email", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to send OTP", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VerifyOtpAsync()
    {
        if (!_otpFormIsValid) return;

        _loading = true;
        try
        {
            var request = new { email = _email, otp = _otp };
            var response = await Http.PostAsJsonAsync("api/auth/verify-otp", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var token = result.ValueKind != System.Text.Json.JsonValueKind.Undefined && result.TryGetProperty("token", out var tokenProp)
                    ? tokenProp.GetString()
                    : null;
                if (token != null)
                {
                    // Store token in sessionStorage
                    await Http.GetAsync("javascript:window.sessionStorage.setItem('auth_token', '" + token + "')");
                    Snackbar.Add("Login successful", Severity.Success);
                    Nav.NavigateTo("/dashboard", replace: true);
                }
                else
                {
                    Snackbar.Add("Invalid response from server", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Invalid OTP", Severity.Error);
                _otp = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BackToEmailAsync()
    {
        _showOtpInput = false;
        _otp = string.Empty;
        await Task.CompletedTask;
    }
}
