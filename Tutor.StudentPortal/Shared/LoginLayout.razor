@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Default">
        <img class="brand-mark" src="@ThemeAssets.LogoWave" alt="" />
        <MudText Typo="Typo.h6" Style="font-weight:600;">Tutor — Student Portal</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudMainContent Style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background: var(--c-bg);">
        @Body
    </MudMainContent>
</MudLayout>
