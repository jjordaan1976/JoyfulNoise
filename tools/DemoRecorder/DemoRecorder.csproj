<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Records the product demo as a video with Playwright (headless Chromium, 1280x720 WebM).
    Not part of Tutor.slnx. See README.md in this folder for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tutor.Tools.DemoRecorder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
  </ItemGroup>

</Project>
